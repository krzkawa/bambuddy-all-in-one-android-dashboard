<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      One neutral ink ramp, and three colours that each mean exactly one thing.
      Interactive things are light, not blue: colour is reserved for what the
      printer is doing, so a green on this screen always means the same thing.
    -->
    <color name="bg">#FF0B0D10</color>
    <color name="bg_rail">#FF101318</color>
    <color name="card">#FF16191F</color>
    <color name="card_alt">#FF1D212A</color>
    <color name="stroke">#FF262B35</color>
    <color name="stroke_soft">#FF1E222B</color>

    <color name="text">#FFF1F3F7</color>
    <color name="text_dim">#FF98A1AF</color>
    <color name="text_faint">#FF6B7484</color>

    <!-- The one interactive colour: a light neutral, with ink for what sits on it. -->
    <color name="accent">#FFD8DFE9</color>
    <color name="accent_ink">#FF0B0D10</color>
    <color name="pressed">#FF2A3040</color>

    <color name="good">#FF5FBD87</color>
    <color name="warn">#FFD6A244</color>
    <color name="bad">#FFD8695D</color>
</resources>
